:root {
  --primary: ${primary_color};
}

body {
  margin: 0;
  font-family: system-ui, sans-serif;
  line-height: 1.6;
  color: #222;
}

header {
  background: var(--primary);
  color: white;
  padding: 1rem 2rem;
}

nav a {
  color: white;
  margin-right: 1rem;
  text-decoration: none;
}

main {
  max-width: 800px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.tagline {
  font-size: 1.25rem;
  color: var(--primary);
}

.hero {
  width: 100%;
  height: 250px;
  object-fit: cover;
  background: #eee;
}

.order-form {
  display: grid;
  gap: 1rem;
  max-width: 400px;
}

.order-form input,
.order-form textarea {
  width: 100%;
  padding: 0.5rem;
}

.order-form button {
  background: var(--primary);
  color: white;
  border: none;
  padding: 0.75rem;
  cursor: pointer;
}

footer {
  text-align: center;
  padding: 1rem;
  color: #666;
}
